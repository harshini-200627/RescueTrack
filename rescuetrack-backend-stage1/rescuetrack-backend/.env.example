# ---------------------------------------------------------------
# RescueTrack backend - environment variables
# Copy this file to ".env" and fill in real values. NEVER commit .env
# ---------------------------------------------------------------

NODE_ENV=development
PORT=5000

# Frontend origin allowed by CORS (your Vite dev server)
CLIENT_URL=http://localhost:5173

# MongoDB Atlas connection string (include the database name, e.g. /rescuetrack)
# Example: mongodb+srv://<db_user>:<db_password>@<cluster-host>/rescuetrack?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://:@cluster0.0qqcfsk.mongodb.net/
JWT_SECRET=your_generated_jwt_secret

# JWT - JWT_SECRET must be a long random string (at least 32 characters).
# Generate one with:
#  node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_generated_jwt_secret
JWT_EXPIRES_IN=1d
# bcrypt cost factor (10-14 is reasonable)
BCRYPT_SALT_ROUNDS=12

# Rate limiting for /api/auth/signup and /api/auth/login
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RATE_LIMIT_MAX=10

# ---------------------------------------------------------------
# Administrator initialization (used ONLY by: npm run seed:admin)
# Set these, run the script once, then REMOVE ADMIN_PASSWORD from .env.
# ---------------------------------------------------------------
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
